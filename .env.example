# API Keys for Running Real Empirical Models (Jalur A)
# Rename this file to .env or export environment variables before running scripts/run_benchmark.py

# 1. OpenAI (For GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# 2. OpenRouter (Optional: Allows running Llama-3.1-8B, Qwen-2.5-7B, SEA-LION via unified API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Custom vLLM / Local Endpoint (Optional)
# OPENAI_BASE_URL=http://localhost:8000/v1
